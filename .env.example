# ------------------------------------------------------------------
# M.Power Engineering public website – environment variables
# Copy to `.env.local` for local development.
# In Cloudflare Pages add the same names under Settings → Variables
# (Production AND Preview). They are used by the build AND by the
# small Pages Functions that add link previews and the sitemap.
#
# Both Supabase values are PUBLIC by design. The website can only read
# published content because of the database's Row Level Security rules.
# NEVER put the service_role key here.
# ------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional but recommended once you have a final address, e.g.
# https://mpowerengineer.org  or  https://mpower-engineering.pages.dev
# Used for canonical links, the sitemap and social previews.
# No trailing slash.
VITE_SITE_URL=
